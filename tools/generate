#!/bin/sh
# Generates gen/, which every build reads and nobody edits:
#
#   contract  from model/smithy/: for each service its Rust server crate and its
#             OpenAPI document, and the management API's TypeScript client
#   design    the renderer's design tokens and fonts, which the flake's design
#             package resolves from the pinned release of TRMNL's design system
#   linen     the web UI's design language, at the revision flake.lock pins
#
# Without an argument, all three. The Nix builds lay gen/ out the same way:
# deploy/nix/contract.nix runs this script's contract part, the server's build
# copies the design package to gen/design, and the web UI's build copies the
# linen package to gen/linen.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
part=${1:-all}
case $part in
all | contract | design | linen) ;;
*)
	echo "usage: tools/generate [contract | design | linen]" >&2
	exit 2
	;;
esac
wants() {
	[ "$part" = all ] || [ "$part" = "$1" ]
}
mkdir -p gen

if wants contract; then
	rm -rf build/smithy
	smithy build
	rm -rf gen/device-api gen/device-api.openapi.json gen/management-api gen/management-api.openapi.json gen/management-client
	cp -r build/smithy/device/rust-server-codegen gen/device-api
	cp build/smithy/device/openapi/DeviceApi.openapi.json gen/device-api.openapi.json
	cp -r build/smithy/management/rust-server-codegen gen/management-api
	cp build/smithy/management/openapi/Management.openapi.json gen/management-api.openapi.json
	cp -r build/smithy/management/typescript-client-codegen gen/management-client
fi

if wants design; then
	nix build "$root#design" --out-link build/design
	rm -rf gen/design
	cp -rL --no-preserve=mode build/design gen/design
fi

if wants linen; then
	nix build "$root#linen" --out-link build/linen
	rm -rf gen/linen
	cp -rL --no-preserve=mode build/linen gen/linen
fi
