#!/bin/sh
# Generates the contract into gen/: the device API's Rust server crate and its OpenAPI
# document. The Nix contract build (deploy/nix/contract.nix) runs this script too, so
# it alone owns the layout.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
rm -rf build/smithy
smithy build
rm -rf gen/device-api gen/device-api.openapi.json
mkdir -p gen
cp -r build/smithy/source/rust-server-codegen gen/device-api
cp build/smithy/source/openapi/DeviceApi.openapi.json gen/device-api.openapi.json
