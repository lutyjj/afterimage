#!/bin/sh
# Refreshes crates/render-typst/design/ (design tokens and fonts) from the pinned
# release of TRMNL's design system, for every profile in the catalogue snapshot.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
nix run "$root#tokens" -- "$root/crates/trmnl/catalog" "$root/crates/render-typst/design"
