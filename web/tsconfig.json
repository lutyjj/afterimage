{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // A workaround: verbatimModuleSyntax would refuse the generated client's auth
    // files, which smithy-typescript writes with value imports of types such as
    // TokenIdentity, and would keep those imports at run time. Restore it once
    // smithy-typescript writes `import type` there. isolatedModules still keeps
    // every file compilable alone, as Vite needs.
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@afterimage/management-client": ["../gen/management-client/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
